# Copier en .env (ignoré par Git) : « cp .env.example .env », puis « docker compose up --build ».
# Toutes les valeurs ci-dessous sont fictives et réservées à un usage local ou de démonstration.
# Pour un vrai déploiement, remplacer au minimum DB_PASSWORD et JWT_SECRET, et retirer le profil demo.

# --- Base de données (US-02) ---
DB_NAME=smartrecruit
DB_USERNAME=smartrecruit
DB_PASSWORD=local-demo-only-db-password
# Utilisée seulement par le backend lancé hors Docker (profil dev) ; docker compose fixe sa propre URL
DB_URL=jdbc:postgresql://localhost:5432/smartrecruit

# --- Application ---
# prod : logs JSON, aucune valeur par défaut ; demo : données fictives chargées sur une base vide (US-56)
SPRING_PROFILES_ACTIVE=prod,demo
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# Mot de passe commun des comptes de démonstration (voir le README)
DEMO_PASSWORD=Demo-SmartRecruit-2026

# --- Sécurité (US-07) ---
# Clé HMAC des access tokens, 32 caractères minimum. Générer une vraie clé : openssl rand -base64 48
JWT_SECRET=local-demo-only-secret-change-me-0123456789abcdefghijklmnop
# Premier administrateur, créé au démarrage s'il n'en existe aucun (sans le profil demo) ;
# mot de passe à changer à la première connexion
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Assistance IA (phase 8, facultative) ---
# Ollama arrêté ou modèle pas encore téléchargé : l'application reste entièrement utilisable
AI_ENABLED=true
# Modèle et version d'Ollama choisis par le banc d'essai (docs/ai-model-benchmark.md)
AI_MODEL=qwen3.5:4b
# OLLAMA_VERSION=0.40.14
# Raisonnement du modèle : false (défaut) le coupe ; vide, le champ n'est pas envoyé et le modèle décide
# AI_THINK=false

# --- Backend lancé hors Docker uniquement ---
# STORAGE_ROOT=./data/resumes
